# Copie para .env.local e preencha. Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Supabase: Project Settings > API (Project URL e chave "anon public").
# Sem estas duas, o site mostra o conteúdo de exemplo e o /admin fica desligado.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp padrão da FFMA (DDI + DDD + número, só dígitos). Pode ser trocado depois em Admin > Configurações.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Defina como 1 no lançamento para liberar a indexação no Google.
NEXT_PUBLIC_SITE_LIVE=
